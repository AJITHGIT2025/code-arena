# =======================================================
# CODE ARENA — Environment Variables
# =======================================================

PORT=5000
NODE_ENV=production

# Database URL
# Local SQLite default:
DATABASE_URL="file:./dev.db"
# Managed PostgreSQL (e.g. Supabase / Neon / Render / Railway):
# DATABASE_URL="postgresql://username:password@ep-host.region.pooler.supabase.com:6543/postgres?sslmode=require"

# JWT Secret Key (Use a strong random string)
JWT_SECRET="code-arena-secret-change-to-at-least-32-chars-in-production"

# Judge0 Isolated Code Execution Engine
# Option A: Judge0 CE Public (Free, Default): https://ce.judge0.com
# Option B: RapidAPI Judge0 (Paid/Free tier): https://judge0-ce.p.rapidapi.com
# Option C: Self-hosted Judge0 instance: http://your-judge0-server:2358
JUDGE0_API_URL="https://ce.judge0.com"
JUDGE0_API_KEY=""
JUDGE0_API_HOST=""

# Allowed Client Origin (for CORS when client and server are hosted on different domains)
CLIENT_URL="http://localhost:5173"
