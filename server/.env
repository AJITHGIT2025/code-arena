# CODE ARENA Server Environment Variables
PORT=5000
NODE_ENV=development

# Database Connection (SQLite by default for zero-friction local execution, PostgreSQL supported)
DATABASE_URL="file:./dev.db"

# JWT Secret for authentication tokens
JWT_SECRET="code-arena-jwt-secret-key-change-in-production-2026"

# Code Execution Engine (local / judge0 / auto)
# "local" executes instantly (sub-second) using local/container compilers (gcc, g++, javac, python)
# Falls back to Judge0 automatically if a local compiler is missing.
EXECUTION_ENGINE="local"
JUDGE0_API_URL="https://ce.judge0.com"
JUDGE0_API_KEY=""
JUDGE0_API_HOST=""

# Allowed Client Origin (for CORS)
CLIENT_URL="http://localhost:5173"
