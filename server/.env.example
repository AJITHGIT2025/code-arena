# CODE ARENA Server Environment Variables Template
PORT=5000
NODE_ENV=production

# Database Connection
# SQLite: "file:./dev.db"
# PostgreSQL (Production e.g. Supabase/Neon/Render): "postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
DATABASE_URL="file:./dev.db"

# JWT Secret
JWT_SECRET="your-secure-jwt-secret-at-least-32-characters"

# Judge0 Code Execution
# Option 1: Judge0 CE Public (free default): "https://ce.judge0.com"
# Option 2: RapidAPI Judge0: "https://judge0-ce.p.rapidapi.com" (with JUDGE0_API_KEY & HOST)
# Option 3: Self-Hosted Judge0 / Docker: "http://your-judge0-host:2358"
JUDGE0_API_URL="https://ce.judge0.com"
JUDGE0_API_KEY=""
JUDGE0_API_HOST=""

# Client Origin for CORS
CLIENT_URL="https://your-frontend-domain.vercel.app"
